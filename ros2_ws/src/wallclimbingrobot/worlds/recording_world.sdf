<sdf version="1.9">
  <world name="robot_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>
    <model name="climbing_wall">
      <static>true</static>
      <pose>0.1 0 2 0 0 0</pose>
      <link name="wall">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 3 4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 3 4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.72 0.8 1</ambient>
            <diffuse>0.65 0.72 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <model name="recording_camera">
      <static>true</static>
      <pose>-8 -2 2.2 0 0.02425 0.24498</pose>
      <link name="camera_link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <topic>/recording_camera/image</topic>
          <plugin filename="gz-sim-camera-video-recorder-system" name="gz::sim::systems::CameraVideoRecorder">
            <service>/recording_camera/record_video</service>
          </plugin>
        </sensor>
      </link>
    </model>
    <light type="directional" name="front_fill">
      <pose>-5 -3 6 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <direction>1 0.2 -0.3</direction>
    </light>
  </world>
</sdf>